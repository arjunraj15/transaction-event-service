# Copy to .env for local runs outside Docker. Never commit real values.
ENVIRONMENT=local
LOG_LEVEL=INFO

# Neon gives a URL like postgresql://user:pass@host/db?sslmode=require (used as-is; normalized in code)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/transactions

# Local Kafka (docker compose). For Confluent Cloud set SASL_SSL + API key/secret.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_API_KEY=
# KAFKA_API_SECRET=
KAFKA_TOPIC_TRANSACTIONS=transactions.received
KAFKA_TOPIC_DLQ=transactions.dlq
KAFKA_CONSUMER_GROUP=transaction-processor
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION_FACTOR=1

PRODUCE_TIMEOUT_SECONDS=0.4
PROCESSING_DELAY_SECONDS=30
PROCESSING_MAX_ATTEMPTS=3

# Optional: enables HMAC-SHA256 verification of the X-Razorpay-Signature header
# WEBHOOK_SECRET=
